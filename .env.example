# Proveedor del modelo: anthropic | mock (mock = sin clave, solo para probar el front)
LLM_PROVIDER=anthropic
# Clave de Anthropic. Solo en el backend; nunca en el repo, el front ni los logs.
ANTHROPIC_API_KEY=
# Modelo (verifica el nombre vigente en console.anthropic.com)
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000
# Límites de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
MAX_PETICIONES_MINUTO=20
# Opcional: si se define, el front pide esta clave para usar el link público
ACCESS_KEY=
PORT=3000
